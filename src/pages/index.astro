---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../config/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 6);

const categories = [
  {
    slug: 'projects',
    title: 'Projects',
    description: 'Things I build, experiment with and learn while building.',
  },
  {
    slug: 'tech',
    title: 'Tech',
    description: 'Notes, guides and ideas around software, AI, cloud and engineering.',
  },
  {
    slug: 'dsa',
    title: 'Dsa',
    description: 'Patterns, problem solving, and the discipline behind efficient code.',
  },
  {
    slug: 'travel',
    title: 'Travel',
    description: 'Stories, photographs and observations from places I visit.',
  },
  {
    slug: 'reflections',
    title: 'Reflections',
    description: 'Productivity, work, learning, life lessons and personal observations.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={siteConfig.siteName} description={siteConfig.description} />
  </head>
  <body>
    <Header />

    <main>
      <section class="site-shell hero">
        <div class="hero-grid">
          <div>
            <h1 class="hero-name">Abhinay<br />Rana</h1>
            <p class="hero-lead">{siteConfig.intro}</p>
            <a class="hero-link" href={siteConfig.portfolioUrl} target="_blank" rel="noreferrer">
              Visit my portfolio → abhinayrana.com
            </a>
          </div>
          <div class="hero-note">
            <div class="mini-card">
              <p class="eyebrow">Current focus</p>
              <p>Building thoughtful products, learning with intention, and documenting the journey.</p>
            </div>
            <div class="mini-card">
              <p class="eyebrow">Notes from the field</p>
              <p>Technology, projects, travel, and reflections from a life lived in motion.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="site-shell page-section">
        <div class="list-header">
          <h2>Latest writing</h2>
          <a href="/projects">Browse all →</a>
        </div>
        <div class="article-list">
          {posts.map((post) => <ArticleCard post={post} />)}
        </div>
      </section>

      <section class="site-shell page-section about-section">
        <div class="about-header">
          <h2>About</h2>
        </div>
        <div class="about-layout">
          <p class="about-copy">Developer, builder and occasional wanderer. I write about creating things, understanding systems, and traveling with attention.</p>
          <div class="social-links" aria-label="Social links">
            <a class="social-link" href={siteConfig.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.22c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.32-3.37-1.32-.46-1.2-1.12-1.52-1.12-1.52-.92-.64.07-.63.07-.63 1.02.07 1.56 1.08 1.56 1.08.9 1.57 2.36 1.12 2.93.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.39-2.04 1.03-2.76-.1-.25-.45-1.29.1-2.68 0 0 .86-.28 2.8 1.07A9.48 9.48 0 0 1 12 7.7c.87 0 1.75.12 2.57.35 1.93-1.35 2.8-1.07 2.8-1.07.55 1.39.2 2.43.1 2.68.64.72 1.03 1.64 1.03 2.76 0 3.95-2.34 4.82-4.57 5.07.36.32.68.95.68 1.91v2.83c0 .27.18.6.69.49A10.22 10.22 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z"/></svg>
              <span>GitHub</span>
            </a>
            <a class="social-link" href={siteConfig.linkedinUrl} target="_blank" rel="noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 8.5A1.5 1.5 0 1 1 6.94 5a1.5 1.5 0 0 1 0 3.5ZM5.5 9.75h2.88v8.5H5.5v-8.5Zm5.16 0h2.76v1.16h.04c.38-.73 1.32-1.5 2.72-1.5 2.91 0 3.45 1.92 3.45 4.41v4.43h-2.88v-4.15c0-1-.02-2.29-1.39-2.29-1.4 0-1.61 1.09-1.61 2.22v4.22H10.66v-8.5Z"/></svg>
              <span>LinkedIn</span>
            </a>
            <a class="social-link" href={siteConfig.portfolioUrl} target="_blank" rel="noreferrer" aria-label="Portfolio">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9Zm2.5-.5a.5.5 0 0 0-.5.5v9c0 .28.22.5.5.5h11a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-11Zm1.5 2h8v2h-8V9Zm0 3h5v2h-5v-2Z"/></svg>
              <span>Portfolio</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

