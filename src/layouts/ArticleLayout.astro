---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Prose from '../components/Prose.astro';
import { ReadingProgress } from '../components/ReadingProgress';
import { estimateReadingTime, formatDate, getPostPath } from '../lib/posts';
import Tag from '../components/Tag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const currentPath = getPostPath(post.data.category, post.id);
const basePath = import.meta.env.BASE_URL || '/';
const articleUrl = new URL(currentPath.replace(/^\//, ''), Astro.site ?? 'https://abhinayana.blog').toString();
const readingTime = estimateReadingTime(post.body ?? '');
const articleMeta = post.data.updatedDate ? `Updated ${formatDate(post.data.updatedDate)}` : `Published ${formatDate(post.data.publishedDate)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${post.data.title} | Abhinay Rana`} description={post.data.description} image={post.data.coverImage ? post.data.coverImage.src : '/og-default.jpg'} />
  </head>
  <body>
    <ReadingProgress client:load />
    <Header />
    <article class="site-shell article-header">
      <div class="page-shell">
        <p class="kicker">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <div class="article-meta">
          <span>{formatDate(post.data.publishedDate)}</span>
          <span>·</span>
          <span>{readingTime} min read</span>
          {post.data.updatedDate ? <span>·</span> : null}
          {post.data.updatedDate ? <span>{articleMeta}</span> : null}
        </div>

        {
          post.data.coverImage ? (
            <div class="cover-image-wrap">
              <Image src={post.data.coverImage} alt={post.data.title} width={1200} height={720} />
            </div>
          ) : null
        }

        <Prose>
          <slot />
        </Prose>

        <div class="article-footer">
          <div>
            <p class="eyebrow">Tags</p>
            <div class="tags-wrap">
              {post.data.tags.map((tag) => <Tag label={tag} />)}
            </div>
          </div>
          <div>
            <p class="eyebrow">Share</p>
            <div class="tags-wrap">
              <a class="tag" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noreferrer">LinkedIn</a>
              <a class="tag" href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noreferrer">X</a>
              <button class="tag" type="button" onclick={`navigator.clipboard.writeText('${articleUrl}')`}>Copy link</button>
            </div>
          </div>
        </div>
      </div>
    </article>

    <section class="site-shell page-section">
      <div class="page-shell">
        <div class="list-header">
          <h2>Related</h2>
        </div>
        <div class="related-list">
          {related.map((entry) => (
            <a href={getPostPath(entry.data.category, entry.id)} class="category-card">
              <strong>{entry.data.title}</strong>
              <p>{entry.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
    <Footer />
  </body>
</html>
